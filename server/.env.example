# Port the Express server listens on. Vite dev proxy targets 3001.
PORT=3001

# Set to "true" to run the hourly data collector inside the main server
# process. Leave unset (or "false") if you run `npm run collector` as a
# standalone process instead.
ENABLE_COLLECTOR=false

# PostgreSQL connection. The app uses node-postgres (pg) with a Pool.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=eve_emptiness
PGUSER=eve_emptiness
PGPASSWORD=replace-me
